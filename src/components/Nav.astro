---
import Brand from "./Brand.astro";

interface Props {
	currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const navLinks = [
	{ label: "Home", href: "/" },
	{ label: "Projects", href: "/projects" },
	{ label: "About", href: "/about" },
];
---

{/* A full-width dark band rather than the old floating glass pill. The cyan
    IVA mark was drawn for a dark ground, so the band is where the brand
    lives while the page itself is paper. */}
<header class="sticky top-0 z-50 bg-band text-band-ink border-b border-band-rule">
	<div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5 md:px-8">
		<a href="/" aria-label="ivantsov.tech home">
			<Brand markId="nav" size={18} wordmark={11} gap={8} />
		</a>

		<nav aria-label="Main" class="hidden md:flex items-center gap-7 text-sm">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						aria-current={currentPath === link.href ? "page" : undefined}
						class:list={[
							"py-1 transition-colors",
							currentPath === link.href
								? "text-band-ink border-b-2 border-brand-cyan"
								: "text-band-muted hover:text-band-ink",
						]}
					>
						{link.label}
					</a>
				))
			}
			<a
				href="https://umbrellaitgroup.com/contact-us/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-band-muted hover:text-band-ink transition-colors"
			>
				Work with me
			</a>
			<button
				type="button"
				data-theme-toggle
				class="w-8 h-8 -mr-1 flex items-center justify-center rounded text-band-muted hover:text-band-ink transition-colors"
				aria-label="Switch to dark theme"
			>
				<svg data-icon-moon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
				<svg data-icon-sun width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
			</button>
		</nav>

		<div class="flex md:hidden items-center gap-1">
			<button
				type="button"
				data-theme-toggle
				class="w-10 h-10 flex items-center justify-center rounded text-band-muted"
				aria-label="Switch to dark theme"
			>
				<svg data-icon-moon width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
				<svg data-icon-sun width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
			</button>
			<button
				type="button"
				id="menu-toggle"
				class="w-10 h-10 flex items-center justify-center rounded text-band-ink"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="md:hidden hidden border-t border-band-rule">
		<nav aria-label="Main" class="flex flex-col px-5 py-3 text-lg">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						aria-current={currentPath === link.href ? "page" : undefined}
						class:list={[
							"py-2.5",
							currentPath === link.href ? "text-brand-cyan" : "text-band-ink",
						]}
					>
						{link.label}
					</a>
				))
			}
			<a
				href="https://umbrellaitgroup.com/contact-us/"
				target="_blank"
				rel="noopener noreferrer"
				class="py-2.5 text-band-ink"
			>
				Work with me
			</a>
			<a href="mailto:alex@ivantsov.tech" class="py-2.5 text-band-muted text-base">
				alex@ivantsov.tech
			</a>
		</nav>
	</div>
</header>

<script>
	// Bound on astro:page-load because the ClientRouter replaces the body on
	// every navigation, taking the old listeners with it.
	function syncThemeButtons() {
		const dark = document.documentElement.dataset.theme === "dark";
		document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((btn) => {
			btn.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
			btn.querySelector("[data-icon-moon]")?.classList.toggle("hidden", dark);
			btn.querySelector("[data-icon-sun]")?.classList.toggle("hidden", !dark);
		});
	}

	function initNav() {
		syncThemeButtons();

		document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const root = document.documentElement;
				const dark = root.dataset.theme !== "dark";
				if (dark) root.dataset.theme = "dark";
				else delete root.dataset.theme;
				try {
					localStorage.setItem("theme", dark ? "dark" : "light");
				} catch {}
				syncThemeButtons();
			});
		});

		const toggle = document.getElementById("menu-toggle");
		const menu = document.getElementById("mobile-menu");
		toggle?.addEventListener("click", () => {
			const open = menu?.classList.toggle("hidden") === false;
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		});
	}

	document.addEventListener("astro:page-load", initNav);
</script>
