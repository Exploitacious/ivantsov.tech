---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Ivantsov.tech",
	description = "Alex Ivantsov: father, operations manager, sysadmin, builder.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wdth,wght@0,75..100,400..700;1,75..100,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		{/* Theme before first paint, so nobody sees a flash of the wrong theme.
		    Dark is the default (Alex, 2026-11-21: "Dark mode for sure") and is
		    set on <html> in the markup, so it holds without JavaScript too; only
		    a saved "light" choice from the nav toggle removes it. */}
		<script is:inline>
			(function () {
				var saved = null;
				try {
					saved = localStorage.getItem("theme");
				} catch (e) {}
				if (saved === "light") delete document.documentElement.dataset.theme;
			})();
		</script>

		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="bg-paper text-ink font-sans antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70] focus:bg-ink focus:text-paper focus:px-3 focus:py-2 focus:rounded"
			>Skip to content</a
		>
		<slot />

		<script is:inline>
			// The ClientRouter swaps <html> attributes on navigation, which would
			// drop data-theme; re-apply the saved theme on every swap.
			document.addEventListener("astro:after-swap", function () {
				var saved = null;
				try {
					saved = localStorage.getItem("theme");
				} catch (e) {}
				var dark = saved !== "light";
				if (dark) document.documentElement.dataset.theme = "dark";
				else delete document.documentElement.dataset.theme;
			});
		</script>
	</body>
</html>
