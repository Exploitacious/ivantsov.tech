// Lucide `arrow-right`, matched to the 24x24 / 2px stroke geometry of the
// `icons` map in index.astro. The site's up-right arrow means "this leaves the
// site"; /projects does not, so on-site navigation gets a horizontal arrow.
const arrowRight = "M5 12h14M12 5l7 7-7 7";

// ── Proof / Scale Metrics ──
const scaleMetrics = [
	{
		value: "30+",
		label: "Custom MCP Servers",
		detail: "FastMCP & Cloudflare Workers",
	},
	{
		value: "130+",
