---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import profileImage from "../assets/images/Alex.jpg";

// Copy pass 2026-11-21: prose rewritten shorter (first draft by Gemini 4
// Neon, edited for accuracy, then fact-checked against the previous copy).
// Every number, metric, role, principle, and highlight is still here and the
// skill lists are byte-identical; some phrasing and minor asides were cut.

const copy = {
	headline: "I run operations at a growing MSP, and I build the systems it runs on.",
	sub: "Automation, cloud infrastructure, data pipelines, and governed AI tooling, from strategy and schema design down to the container and the alert rule.",
	aboutMe: [
		"I started as an MSP engineer fixing technical problems and grew into leading operations for a growing MSP. My week crosses engineering, sales, compliance, and client strategy. Because MSPs sit at the workflow layer across finance, operations, compliance, and IT, I can draw a direct line from technology choices to business outcomes.",
		"I work as a generalist who goes deep on whichever constraint is holding an operation back, and I fix that bottleneck first. Day to day I wire our tools together with automation, run client relationships, build compliance programs, train engineers, and ship governed AI agents that work directly on live operational tools.",
		"Over the past few years that work expanded into full-stack engineering and AI infrastructure. In a given week I ship Python FastMCP servers, extend a cross-vendor PostgreSQL entity graph, maintain an open-source MCP gateway, provision Terraform infrastructure, or deploy TypeScript edge services with OAuth 2.1 and Durable Objects. I like owning the whole line, schema through alert rule.",
		"Outside work I build financial signals intelligence software, run a multi-agent Proxmox homelab, publish open-source tooling for other operators, and volunteer hands-on AI adoption and custom connector engineering for a local nonprofit.",
	],
	skillsIntro: "I operate across a wide technical surface. Here is where I go deepest.",
	beyond: "Father first, engineer second. Outside family time I run a Proxmox homelab with 18+ services and a fleet of containerized AI agents, alongside a 2,500+ commit financial signals and options-analytics platform, a personal design system, cross-platform dotfiles, and pro-bono AI work for a local nonprofit. I learn best by running real systems in production and living with the consequences.",
	cta: "Want to talk shop or work together? Send me a note.",
};

// ── Proof / Scale Metrics ──
// Every number here is checked against a source before it ships:
//  - MCP servers: server directories in the MCP monorepo (35 on 2026-11-21).
//  - Vendor platforms: sources merged by the entity graph's sync workers.
//  - PowerShell scripts: .ps1 files in the RMM script library (268).
//  - Upstream PRs: merged PRs by Exploitacious in CyberDrain/CIPP (19).
// Star counts are left out on purpose: the most-starred public fork lives
// under the employer's GitHub org, and counting it would name the employer.
const scaleMetrics = [
	{
		value: "30+",
		label: "Custom MCP servers",
		detail: "Python FastMCP and edge Workers",
	},
	{
		value: "8+",
		label: "Vendor platforms unified",
		detail: "Merged in one PostgreSQL entity graph",
	},
	{
		value: "260+",
		label: "Production PowerShell scripts",
		detail: "Endpoint automation library",
	},
	{
		value: "19",
		label: "Merged upstream CIPP PRs",
		detail: "Open-source M365 management",
	},
];

// ── What I Do ──
const roles = [
	{
		title: "Automation and integration engineering",
		body: "I wire business tools together with N8n workflows, PowerShell, webhooks, and REST APIs to cut out manual handoffs across the MSP stack. I also build the MCP servers that give AI agents direct, governed access to those same systems.",
	},
	{
		title: "IT strategy and client engagement",
		body: "I advise clients through quarterly business reviews and technology roadmaps, and I design our sales process, proposals, and client materials. Every engagement starts with the client's constraints and goals, then draws a direct line from IT work to business outcomes.",
	},
	{
		title: "Cybersecurity and compliance",
		body: "I build and run compliance programs grounded in real security: CMMC frameworks, incident response planning, secure configuration management, and security tooling rollouts. I care about red team and blue team thinking, and about making compliance meaningful rather than performative.",
	},
	{
		title: "Operations and process design",
		body: "I design internal operations, from dispatch workflows to change management, using Theory of Constraints and continuous improvement. The goal stays the same: make the work visible, clear the bottlenecks, and write processes the team actually follows.",
	},
	{
		title: "AI platform and MCP architecture",
		body: "I connect language models to live tools through 30+ custom FastMCP servers, a self-hosted MCP gateway I maintain as an open-source fork, OAuth 2.1 connectors on Cloudflare Workers, and an AI teammate in Microsoft Teams. Every write tool previews the change, reads back what landed, and leaves an audit trail.",
	},
	{
		title: "Full-stack software and cloud infrastructure",
		body: "I take internal platforms, web apps, Electron desktop software, and cloud environments from architecture to production: Terraform and GitOps, PostgreSQL entity graphs, FastAPI, Astro and React, Grafana and Loki. No handoff wall between the application and the infrastructure under it.",
	},
];

