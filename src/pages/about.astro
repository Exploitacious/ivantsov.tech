// Split for the skills layout: the expert tier reads in ink, advanced in
// muted, each as run-in text rather than a wall of pills.
const levels = [
	{ key: "sme", label: "Expert" },
	{ key: "advanced", label: "Advanced" },
] as const;

// ── How I Think ──
const philosophy = [
	{
		headline: "Find the constraint first.",
		body: "Every system has a bottleneck. Under the Theory of Constraints, improving anything other than the thing limiting throughput is an illusion. I run client IT strategy, internal operations, sales conversations, and my own task list through the same filter: what is the one thing holding this back?",
	},
	{
		headline: "Make the work visible.",
		body: "Unplanned work is the silent killer of IT operations. The Phoenix Project and improvement kata shaped how I work: every task should be visible, tracked, and intentional. When work is invisible, priorities are imaginary. The systems I build answer three questions: what are we doing, why, and what is blocked.",
	},
	{
		headline: "Build for control. Buy for sanity.",
		body: "If a vendor solves the problem well and takes the maintenance off my team, buying is often the right call. When control and long-term ROI matter, and the integration layer is the product, I build. The automation platform I built on N8n exists because no off-the-shelf tool could tie our stack together the way we needed.",
	},
	{
		headline: "Unknown is never okay.",
		body: "Silent assumptions break production automation. When a cross-vendor diagnostic checks three network platforms and one does not answer, it reports the gap instead of returning green. Every write tool I ship separates plan from execute, reads back what landed, and logs to an audit ledger. Safety lives in code, not in a hopeful prompt.",
	},
	{
		headline: "Orchestrate the work. Keep state on disk.",
		body: "AI-assisted engineering scales the way an operations team does. Lock the architecture and invariants first, isolate parallel streams in git worktrees, gate merges behind real tests and CI, and review every diff. Software and operations fail for the same reason: durable state living in someone's head instead of tracked files.",
	},
];

// ── Highlighted Work ──
// "scoped access keys" is gone from the AI and MCP items on purpose: it
// describes how the employer's access is gated.
const highlights = [
	{
		label: "Automation platform",
		title: "Replaced our Zapier workflows with an N8n integration engine.",
		body: "It processes PSA ticket webhooks, routes security alerts on the structure of their JSON payloads, enriches tickets with AI, and syncs billing data across systems. It replaced multiple Zapier workflows, cut manual handoffs, and gave us full control over how our tools talk. Not pretty code. Effective code, and it runs every day without complaint.",
	},
	{
		label: "Constraint-based sales",
		title: "Rebuilt our sales discovery around one question: what's your constraint?",
		body: "I rebuilt the sales deck and discovery process around three business metrics (financial accuracy, operational efficiency, legal compliance), anchored by the Theory of Constraints. We ask prospects about their goals and constraints, then draw a direct line from IT to outcomes. It moved us from IT support company to strategic partner in every conversation.",
	},
	{
		label: "Operations buildout",
		title: "Wrote a growing MSP's operational playbook from scratch.",
		body: "SOPs for helpdesk, dispatch, escalation, and project management. The MSA and services guide. Vendor evaluation and rollout from RMM to PSA to compliance tooling. The technical documentation library, engineer training, and the sales process. I didn't inherit a playbook. I wrote one, mostly solo under shifting priorities, then trained the team to run it.",
	},
	{
		label: "AI operations",
		title: "Gave AI real hands on the MSP stack, then put it to work.",
		body: "I built MCP servers across our PSA, RMM, documentation, M365, and voice systems behind a white-labeled gateway. On top of it run a production AI teammate in Microsoft Teams and the multi-agent orchestration harness that runs my daily operations. They read tickets, file documentation, and execute runbooks: governed, logged, and reviewed.",
	},
	{
		label: "MCP and entity graph",
		title: "Unified 8+ vendor platforms into one entity graph and 30+ MCP servers.",
		body: "A monorepo of isolated FastMCP servers covers PSA, RMM, documentation, M365, security, billing, networking, and voice behind a self-hosted gateway. Underneath, a PostgreSQL entity graph merges users, endpoints, cameras, network gear, and inventory from 8+ vendor platforms through MAC address and identity resolution. Engineers and agents query one record instead of ten portals.",
	},
	{
		label: "M365 policy-as-code",
		title: "Turned a 70+ hour Microsoft 365 buildout into versioned baselines.",
		body: "Multi-tenant Microsoft 365 onboarding used to be a manual senior-engineer project. Now it is versioned Conditional Access, Intune, and Purview baseline templates that apply cleanly to a fresh tenant. When the open-source tools I depend on have gaps, I fix them upstream: 19 merged pull requests to CIPP covering baselines, alerting, identity templates, and SharePoint.",
	},
	{
		label: "Pro-bono nonprofit AI",
		title: "Led a local nonprofit's Claude rollout and built the connectors it lacked.",
		body: "I volunteered to lead a local nonprofit's rollout of Claude: org instructions, shared skills, and a staff governance playbook. Their volunteer management platform had no AI integration, so I built an OAuth 2.1 MCP connector suite on Cloudflare Workers that signs staff in with their existing Microsoft identity. Every write is previewed, confirmed, read back, and logged.",
	},
];

// ── One client, eight names ──
// EXAMPLE DATA. Northwind Traders is Microsoft's long-standing fictional
// sample company; every ID below is invented. The table shows the shape of
// the entity-resolution problem without exposing a real client, a real
// vendor tenant, or how the production graph is secured.
const resolution = [
	{ system: "PSA", id: "29184", name: "Northwind Traders, Inc." },
	{ system: "RMM", id: "org-0412", name: "NORTHWIND-TRADERS" },
	{ system: "Documentation", id: "1180457", name: "Northwind Traders" },
