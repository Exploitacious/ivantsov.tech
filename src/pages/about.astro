// ── What I Do cards ──
const roles = [
	{
		title: "Automation & Integration Engineering",
		body: "I design and build the connective tissue between business tools. Webhook-driven workflows, API integrations, AI-augmented processes, whatever it takes to eliminate manual handoffs and make systems talk to each other. My primary platform is N8n, backed by PowerShell scripting and REST APIs across the entire MSP stack. These days I also build MCP servers, the layer that gives AI agents direct, governed access to that same stack.",
	},
	{
		title: "IT Strategy & Client Engagement",
		body: "I serve as the strategic IT advisor for our clients, running quarterly business reviews, building technology roadmaps, and translating business goals into actionable IT plans. I also design our sales process, build proposals, and create client-facing materials. The approach is always the same: start with the client's constraints and goals, then draw a direct line from IT to outcomes.",
	},
	{
		title: "Cybersecurity & Compliance",
		body: "I build and manage compliance programs grounded in real security, not checkbox exercises. My work spans CMMC frameworks, incident response planning, secure configuration management, and security tooling deployment. I care about red team / blue team thinking and making compliance meaningful rather than performative.",
	},
	{
		title: "Operations & Process Design",
		body: "I architect internal operations from dispatch workflows to change management processes, drawing on Theory of Constraints and continuous improvement principles. The goal is always the same: make the work visible, eliminate bottlenecks, and build systems the team actually follows.",
	},
	{
		title: "AI Platform & MCP Architecture",
		body: "I build the production layer that connects language models to live operational tools. That includes over 30 custom FastMCP servers, a maintained open-source MetaMCP gateway fork, OAuth 2.1 Microsoft Entra connectors on Cloudflare Workers, and an autonomous Teams AI teammate backed by an immutable container safety floor and a git-synced brain repo. Every write tool previews changes before touching live state, verifies what landed with a read-back, and records an audit trail.",
	},
	{
		title: "Full-Stack Software & Cloud Infrastructure",
		body: "I take internal platforms, web apps, and cloud environments from architecture through production deployment. My stack spans Terraform and SOPS/age GitOps on Linode and Cloudflare, PostgreSQL 16 entity graphs with 130+ migrations, FastAPI backends, Astro and React frontends, Electron desktop apps, and Grafana/Loki observability. There is no handoff wall between the application code and the infrastructure it runs on.",
	},
