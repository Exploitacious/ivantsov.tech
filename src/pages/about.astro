---

<Layout
	title="About | Alex Ivantsov, operations manager and systems engineer"
	description="Operations manager and systems engineer: MSP operations, automation, AI tooling, cybersecurity, and IT strategy."
>
	<Nav currentPath="/about" />

	<main id="main">
		<!-- Hero -->
		<section class="mx-auto max-w-6xl px-5 md:px-8 pt-12 md:pt-20 pb-14 grid md:grid-cols-12 gap-10 md:gap-12 items-end">
			<div class="md:col-span-8">
				<p class="text-sm text-muted mb-5">Alex Ivantsov, about and experience</p>
				<h1 class="display text-[clamp(2.4rem,5.2vw,4.25rem)] font-semibold leading-[1.02]">
					{copy.headline}
				</h1>
				<p class="mt-6 text-lg md:text-xl text-muted prose-measure">{copy.sub}</p>
			</div>
			<div class="md:col-span-4">
				<Image
					src={profileImage}
					alt="Alex Ivantsov"
					widths={[300, 600]}
					sizes="(min-width: 768px) 30vw, 60vw"
					loading="eager"
					transition:name="profile"
					class="w-48 md:w-full md:max-w-[17rem] md:ml-auto rounded-md"
				/>
			</div>
		</section>

		<!-- Metrics -->
		<section class="mx-auto max-w-6xl px-5 md:px-8">
			<dl class="grid grid-cols-2 md:grid-cols-4 border-y border-rule">
				{
					scaleMetrics.map((m, i) => (
						<div
							class:list={[
								"py-6 md:py-8 pr-4 md:px-6",
								i % 2 === 1 && "pl-4 border-l border-rule",
								i >= 2 && "border-t border-rule md:border-t-0",
								i === 2 && "md:border-l",
								i === 0 && "md:pl-0",
							]}
						>
							<dt class="sr-only">{m.label}</dt>
							<dd class="font-mono text-4xl md:text-5xl font-medium tracking-tight text-ink">{m.value}</dd>
							<dd class="mt-2 font-semibold leading-snug">{m.label}</dd>
							<dd class="mt-1 text-sm text-muted">{m.detail}</dd>
						</div>
					))
				}
			</dl>

			<nav aria-label="On this page" class="flex flex-wrap gap-x-6 gap-y-2 py-6 text-sm">
				<a href="#about" class="link">About</a>
				<a href="#capabilities" class="link">What I do</a>
				<a href="#one-record" class="link">One record</a>
				<a href="#expertise" class="link">Technical expertise</a>
				<a href="#principles" class="link">How I think</a>
				<a href="#work" class="link">Shipped work</a>
				<a href="/projects" class="link">Projects</a>
			</nav>
		</section>

		<!-- About me -->
		<section id="about" class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-20 grid md:grid-cols-12 gap-6 md:gap-12 scroll-mt-20">
			<h2 class="md:col-span-4 display text-3xl md:text-4xl font-semibold">About</h2>
			<div class="md:col-span-8 space-y-5 text-lg leading-relaxed">
				{copy.aboutMe.map((p, i) => <p class:list={["prose-measure", i === 0 ? "text-ink" : "text-muted"]}>{p}</p>)}
			</div>
		</section>

		<!-- What I do -->
		<section id="capabilities" class="border-t border-rule scroll-mt-20">
			<div class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-20 grid md:grid-cols-12 gap-6 md:gap-12">
				<h2 class="md:col-span-4 display text-3xl md:text-4xl font-semibold">What I do</h2>
				<div class="md:col-span-8 grid sm:grid-cols-2 gap-x-10 gap-y-10">
					{
						roles.map((role) => (
							<div>
								<h3 class="text-lg font-semibold leading-snug">{role.title}</h3>
								<p class="mt-2 text-muted leading-relaxed">{role.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- One record: the signature piece. Example data, labeled as such. -->
		<section id="one-record" class="bg-surface scroll-mt-20">
			<div class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-20 grid md:grid-cols-12 gap-6 md:gap-12">
				<div class="md:col-span-4">
					<h2 class="display text-3xl md:text-4xl font-semibold">One client, eight names</h2>
					<p class="mt-4 text-muted leading-relaxed">
						Every vendor platform knows the same client by a different ID and a
						different spelling. The entity graph resolves them into one record,
						so an engineer or an AI agent asks one question instead of opening a
						portal per vendor.
					</p>
				</div>
				<div class="md:col-span-8">
					{/* Phones keep only the system and its name for the client, the two
					    columns that make the point; IDs appear from sm up. There is no
					    "matched on" column on purpose: per-system match keys would
					    describe the production graph's design, which stays private. */}
					<table class="w-full text-left text-sm">
						<caption class="caption-top text-left pb-3 text-sm text-muted">
							<span class="font-semibold text-ink">Example data.</span> Northwind Traders is a fictional company and every ID is invented.
						</caption>
						<thead>
							<tr class="border-b border-ink/25 text-muted">
								<th scope="col" class="py-2.5 pr-4 font-medium">System</th>
								<th scope="col" class="hidden sm:table-cell py-2.5 pr-4 font-medium">Its ID</th>
								<th scope="col" class="py-2.5 font-medium">Its name for the client</th>
							</tr>
						</thead>
						<tbody class="font-mono text-[0.8rem]">
							{
								resolution.map((r) => (
									<tr class="border-b border-rule">
										<th scope="row" class="py-2.5 pr-4 font-sans text-sm font-medium text-ink">{r.system}</th>
										<td class="hidden sm:table-cell py-2.5 pr-4 text-muted">{r.id}</td>
										<td class="py-2.5 text-ink break-all">{r.name}</td>
									</tr>
								))
							}
						</tbody>
						<tfoot>
							<tr>
								<th scope="row" class="pt-4 pr-4 font-sans text-sm font-semibold text-accent align-top">Entity graph</th>
								<td class="hidden sm:table-cell pt-4 pr-4 font-mono text-[0.8rem] text-accent align-top">ent_7f3a91</td>
								<td class="pt-4 align-top">
									<span class="font-semibold text-base text-ink">Northwind Traders</span>
									<span class="block text-sm text-muted mt-0.5">One record for its users, endpoints, cameras, network gear, and inventory</span>
								</td>
							</tr>
						</tfoot>
					</table>
				</div>
			</div>
		</section>

		<!-- Technical expertise -->
		<section id="expertise" class="scroll-mt-20">
			<div class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-20 grid md:grid-cols-12 gap-6 md:gap-12">
				<div class="md:col-span-4">
					<h2 class="display text-3xl md:text-4xl font-semibold">Technical expertise</h2>
					<p class="mt-4 text-muted leading-relaxed">{copy.skillsIntro}</p>
					<p class="mt-4 text-sm text-muted">
						Each category lists two depths: <span class="text-ink font-semibold">Expert</span>,
						where I am the subject matter expert, then <span class="text-ink font-semibold">Advanced</span>.
					</p>
				</div>
				<dl class="md:col-span-8 border-t border-rule">
					{
						skillCategories.map((cat) => (
							<div class="grid sm:grid-cols-8 gap-2 sm:gap-6 py-5 border-b border-rule">
								<dt class="sm:col-span-2 font-semibold leading-snug">{cat.name}</dt>
								<dd class="sm:col-span-6 space-y-2 leading-relaxed">
									{levels.map((lvl) =>
										cat[lvl.key].length > 0 && (
											<p class:list={[lvl.key === "sme" ? "text-ink" : "text-muted"]}>
												<span class="mr-2 text-xs font-semibold text-muted">{lvl.label}</span>
												{cat[lvl.key].join(", ")}
											</p>
										)
									)}
								</dd>
							</div>
						))
					}
				</dl>
			</div>
		</section>

		<!-- How I think -->
		<section id="principles" class="border-t border-rule scroll-mt-20">
			<div class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-20 grid md:grid-cols-12 gap-6 md:gap-12">
				<h2 class="md:col-span-4 display text-3xl md:text-4xl font-semibold">How I think</h2>
				<div class="md:col-span-8 space-y-10">
					{
						philosophy.map((block) => (
							<div>
								<p class="display text-2xl md:text-[1.75rem] font-semibold leading-tight">{block.headline}</p>
								<p class="mt-3 text-muted leading-relaxed prose-measure">{block.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Shipped work -->
		<section id="work" class="border-t border-rule scroll-mt-20">
			<div class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-20 grid md:grid-cols-12 gap-6 md:gap-12">
				<div class="md:col-span-4">
					<h2 class="display text-3xl md:text-4xl font-semibold">Work I'm proud of</h2>
					<a href="/projects" class="link mt-4 inline-block text-sm font-medium">What I build outside the day job</a>
				</div>
				<ol class="md:col-span-8">
					{
						highlights.map((item, i) => (
							<li class:list={["py-8", i > 0 && "border-t border-rule", i === 0 && "pt-0"]}>
								<p class="text-sm font-semibold text-accent">{item.label}</p>
								<h3 class="mt-2 text-xl md:text-2xl font-semibold leading-snug">{item.title}</h3>
								<p class="mt-3 text-muted leading-relaxed prose-measure">{item.body}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- Beyond work -->
		<section id="beyond" class="border-t border-rule scroll-mt-20">
			<div class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-20 grid md:grid-cols-12 gap-6 md:gap-12">
				<h2 class="md:col-span-4 display text-3xl md:text-4xl font-semibold">Beyond work</h2>
				<p class="md:col-span-8 text-lg text-muted leading-relaxed prose-measure">{copy.beyond}</p>
			</div>
		</section>

		<!-- CTA -->
		<section class="mx-auto max-w-6xl px-5 md:px-8">
			<div class="border-t border-ink pt-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
				<p class="display text-2xl md:text-3xl font-semibold">{copy.cta}</p>
				<div class="flex flex-wrap gap-3">
					<a href="mailto:alex@ivantsov.tech" class="btn btn-solid">Email me</a>
					<a href="/projects" class="btn btn-quiet">See the projects</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
