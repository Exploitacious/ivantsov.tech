---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ilianaImage from "../assets/images/Iliana.jpg";
import familyImage from "../assets/images/Family.jpg";
import profileImage from "../assets/images/Alex.jpg";

// All of the page's words live here so a copy pass never has to touch markup.
const copy = {
	hero: {
		current: "Operations Manager at Umbrella IT",
		roles: "Father, operations manager, sysadmin, builder.",
		intro: "I lead MSP operations and build the automation, PostgreSQL entity graphs, and governed AI agents that work on our live operational tools.",
	},
	featured: {
		heading: "For family and friends",
	},
	projectsTeaser: {
		heading: "Tools I build and run",
		// No project count here on purpose: it went stale every time a card
		// was added or cut. The projects page computes its own.
		body: "PowerShell toolkits, an agent-authoring desktop app, the AI harness I run every day, upstream fixes to open-source M365 tooling, financial signals software, and the homelab underneath it all.",
		cta: "See the projects",
	},
	aboutTeaser: {
		heading: "Background and shipped work",
		body: "My resume and working principles: MSP operations, cybersecurity, and Theory-of-Constraints strategy, through PostgreSQL entity graphs, cloud infrastructure, production AI agents, and pro-bono nonprofit work.",
		cta: "Read my background",
	},
	statement: "Find the one constraint holding the operation back. Until it moves, every other improvement is an illusion.",
	connect: {
		heading: "Where to find me",
	},
};

const donationLink = {
	title: "Iliana's College Fund",
	url: "https://www.ugift529.com/gifttpl/ugift/create/viewGiftCodeDetails.cs?ugiftcode=X9V-A82",
	body: 'Gift code <b class="font-mono">X9V-A82</b>. This is a <b>Schwab 529 Education Plan</b>, so the money can only go to education expenses. Thank you for helping support Iliana\'s future.',
	cta: "Open the gift page",
	image: ilianaImage,
	alt: "Iliana",
};

const familyLink = {
	title: "Our Family Media",
	url: "https://family.ivantsov.tech",
	body: "Our family's photos, videos, and memories in one place, running on <b>Jellyfin</b>. You need a login to get in. If you are a family member and need help, reach out to me directly.",
	cta: "Open the family library",
	image: familyImage,
	alt: "The Ivantsov family",
};

const connectLinks = [
	{
		title: "Umbrella IT Solutions",
		url: "https://umbrellaitgroup.com",
		subtitle: "My day job in MSP operations",
		domain: "umbrellaitgroup.com",
	},
	{
		title: "GitHub",
		url: "https://github.com/Exploitacious",
		subtitle: "MSP resources and personal projects",
		domain: "github.com/Exploitacious",
	},
	{
		title: "LinkedIn",
		url: "https://www.linkedin.com/in/alex-ivan-sov/",
		subtitle: "Work history and professional profile",
		domain: "linkedin.com/in/alex-ivan-sov",
	},
];
---

<Layout title="Alex Ivantsov | ivantsov.tech">
	<Nav currentPath="/" />

	<main id="main">
		<!-- Hero: the one bold moment on the site. It continues the dark nav
		     band, and the studio portrait's own dark backdrop is masked into
		     it so the photo has no frame. Everything below is paper. -->
		<section class="bg-band text-band-ink overflow-hidden">
			<div class="relative mx-auto max-w-6xl px-5 md:px-8 grid md:grid-cols-12 md:gap-8 items-end">
				<div class="md:col-span-7 relative z-10 pt-10 md:pt-24 pb-14 md:pb-24 order-2 md:order-1 -mt-24 md:mt-0">
					<p class="text-sm text-band-muted mb-5 flex items-center gap-2">
						<span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-cyan" aria-hidden="true"></span>
						{copy.hero.current}
					</p>
					<h1 class="display text-[clamp(3.5rem,9.5vw,7.25rem)] font-semibold leading-[0.88] text-white">
						Alex<br />Ivantsov
					</h1>
					<p class="mt-7 text-xl md:text-2xl text-band-ink">{copy.hero.roles}</p>
					<p class="mt-4 text-lg text-band-muted max-w-[46ch]">{copy.hero.intro}</p>
					<div class="mt-9 flex flex-wrap gap-3">
						<a href="mailto:alex@ivantsov.tech" class="btn btn-cyan">Email me</a>
						<a href="/projects" class="btn btn-band">See the projects</a>
					</div>
				</div>
				<div class="md:col-span-5 order-1 md:order-2 self-stretch flex items-end -mx-5 md:mx-0">
					<Image
						src={profileImage}
						alt="Alex Ivantsov"
						widths={[400, 700, 1000]}
						sizes="(min-width: 768px) 40vw, 100vw"
						loading="eager"
						transition:name="profile"
						class="hero-portrait w-full md:w-[120%] max-w-none md:-ml-[10%] md:mt-10"
					/>
				</div>
			</div>
		</section>

		<!-- Family -->
		<section class="border-t border-rule">
			<div class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-20">
				<h2 class="display text-3xl md:text-4xl font-semibold mb-10">{copy.featured.heading}</h2>
				<div class="grid md:grid-cols-2 gap-12">
					{
						[donationLink, familyLink].map((item) => (
							<a href={item.url} target="_blank" rel="noopener noreferrer" class="group block">
								<Image
									src={item.image}
									alt={item.alt}
									widths={[500, 900]}
									sizes="(min-width: 768px) 45vw, 90vw"
									class="w-full aspect-[3/2] object-cover rounded-md"
								/>
								<h3 class="mt-5 text-2xl font-semibold group-hover:text-accent transition-colors">
									{item.title}
								</h3>
								<p class="mt-2 text-muted leading-relaxed [&_b]:text-ink [&_b]:font-semibold" set:html={item.body} />
								<span class="link mt-3 inline-block text-sm font-medium">{item.cta}</span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<!-- Work -->
		<section class="border-t border-rule">
			<div class="mx-auto max-w-6xl px-5 md:px-8">
				{
					[
						{ ...copy.projectsTeaser, href: "/projects" },
						{ ...copy.aboutTeaser, href: "/about" },
					].map((item, i) => (
						<a
							href={item.href}
							class:list={[
								"group grid md:grid-cols-12 gap-4 md:gap-12 py-12 md:py-16",
								i > 0 && "border-t border-rule",
							]}
						>
							<h2 class="md:col-span-5 display text-4xl md:text-5xl font-semibold group-hover:text-accent transition-colors">
								{item.heading}
							</h2>
							<div class="md:col-span-7">
								<p class="text-lg text-muted leading-relaxed prose-measure">{item.body}</p>
								<span class="link mt-4 inline-block font-medium">{item.cta}</span>
							</div>
						</a>
					))
				}
			</div>
		</section>

		<!-- Statement -->
		<section class="bg-surface">
			<div class="mx-auto max-w-6xl px-5 md:px-8 py-20 md:py-28">
				<p class="display text-3xl md:text-5xl font-medium leading-[1.12] max-w-[24ch]">
					{copy.statement}
				</p>
				<a href="/about#principles" class="link mt-8 inline-block text-sm font-medium">How I think about the work</a>
			</div>
		</section>

		<!-- Connect -->
		<section id="connect" class="mx-auto max-w-6xl px-5 md:px-8 pt-16 md:pt-20">
			<h2 class="display text-3xl md:text-4xl font-semibold mb-8">{copy.connect.heading}</h2>
			<ul class="border-t border-rule">
				{
					connectLinks.map((link) => (
						<li class="border-b border-rule">
							<a
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								class="row-hover group grid grid-cols-1 md:grid-cols-12 gap-1 md:gap-6 px-2 -mx-2 py-5 items-baseline"
							>
								<span class="md:col-span-4 text-xl font-semibold group-hover:text-accent transition-colors">{link.title}</span>
								<span class="md:col-span-4 text-muted">{link.subtitle}</span>
								<span class="md:col-span-4 md:text-right font-mono text-sm text-muted break-all">{link.domain}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>

	<Footer />
</Layout>
