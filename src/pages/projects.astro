---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// ── Projects ──
// `linkLabel` is the destination as the reader would say it: the repo path for
// public GitHub repos. Private platforms and homelab infrastructure carry no
// external link so public visitors never hit a 404 or an access login.
//
// Claims here stay strictly verifiable against the code and public repos:
//  - Auto-M365 does NOT enable Security Defaults; TenantMaster's published
//    config.json ships "DisableSecurityDefaults": true and the toolkit turns
//    them off, so the baseline is described as Exchange/Entra hardening.
//  - Private client names, internal hostnames, and unreleased upstream drafts
//    stay out of public copy. Only merged upstream work is claimed.
//  - Employer work is described at capability level, in first person, with no
//    employer name, repo link, or security architecture (access gating, secret
//    storage, network layout). The MetaMCP fork lives under the employer's
//    GitHub org, so its row carries no link. "Scoped access keys" was cut
//    from the MCP platform for the same reason (2026-11-21 copy pass).
//  - The list is curated, not exhaustive: a project earns a row when it shows
//    something no other row does. Dropped on 2026-11-21: the dotfiles repo,
//    the early scripts repo, internal quoting apps, the design system, and the
//    seat-rotation tooling (it reads as usage-limit evasion on a resume).
//
// Copy pass 2026-11-21: bodies rewritten shorter and each project gained a
// one-line `hook` (first draft by Gemini 4 Neon, edited for accuracy). Names
// and stacks are unchanged, except the OPS name, which lost its em dash.
type ProjectItem = {
	name: string;
	tag: string;
	hook: string;
	body: string;
	stack: string[];
	url?: string;
	linkLabel?: string;
};

const openSourceProjects: ProjectItem[] = [
	{
		name: "Auto-M365 Suite",
		tag: "PowerShell, MSP tooling",
		hook: "Forty steps of Microsoft 365 tenant onboarding, done by config instead of by hand.",
		body: "Three PowerShell toolkits (TenantMaster, ATP, and DLP) take a fresh Microsoft 365 tenant to a managed, hardened baseline: Exchange and Entra hardening, ATP policies, DLP templates. Everything is config-driven and non-destructive, so it runs against a live tenant without holding your breath. 100+ stars from other people doing the same work.",
		stack: ["PowerShell", "Microsoft 365", "Graph API"],
		url: "https://github.com/Exploitacious/Auto-M365-TenantMaster",
		linkLabel: "Exploitacious/Auto-M365-TenantMaster",
	},
	{
		name: "Hatchling",
		tag: "Desktop app, LLM tool-use",
		hook: "Write an AI agent's personality by talking to it, not by staring at a blank file.",
		body: "You talk through what you want, and the model writes the SOUL, IDENTITY, and USER files through tool calls as it works out what you are after. The output is plain markdown you own outright, no hosted account. Local-first Electron, MIT licensed, and it runs against Anthropic, anything OpenAI-compatible, Ollama, or fully offline.",
		stack: ["Electron", "React", "TypeScript", "LLM tool-use"],
		url: "https://github.com/Exploitacious/hatchling",
		linkLabel: "Exploitacious/hatchling",
	},
	{
		name: "OPS: the Operator's Shell",
		tag: "AI harness, template",
		hook: "A de-identified copy of the Claude Code harness I run every day.",
		body: "Foreman doctrine, where the AI orchestrates sub-agents instead of grinding through the work solo, plus persistent memory, session rituals, and the delegation patterns that keep a multi-agent run from falling apart. Public because the pattern is worth more shared than hoarded.",
		stack: ["Claude Code", "Multi-agent", "Markdown doctrine"],
		url: "https://github.com/Exploitacious/OPS",
		linkLabel: "Exploitacious/OPS",
	},
	{
		name: "CIPP Upstream Contributions",
		tag: "Open source, M365 management",
		hook: "19 merged pull requests to the open-source platform many MSPs use to manage Microsoft 365.",
		body: "When I hit a defect in CIPP, I fix it upstream instead of working around it locally. The merged work covers baseline overrides and imports, Conditional Access templates, alert delivery retries, Defender incident handling, per-tenant identity templates, and SharePoint recycle bin and access reporting.",
		stack: ["PowerShell", "React", "Microsoft Graph", "Azure Functions"],
		url: "https://github.com/CyberDrain/CIPP/pulls?q=is%3Apr+author%3AExploitacious+is%3Amerged",
		linkLabel: "CyberDrain/CIPP merged PRs",
	},
	{
		name: "MetaMCP Gateway (Maintained Fork)",
		tag: "MCP proxy, open-source fork",
		hook: "Upstream stalled for months. A production AI tool layer couldn't wait, so I forked it.",
		body: "A public downstream fork that carries community pull requests plus my own hardening: deterministic tool ordering, connection-pool reliability, session recovery, error-gated server visibility, and structured tool-call audit logging. 35+ stars and automated container builds.",
		stack: ["TypeScript", "Next.js", "Turborepo", "MCP", "Docker"],
	},
	{
		name: "OneNote to Obsidian Migration Toolkit",
		tag: "Migration utility, Python",
		hook: "Years of OneNote documentation out, with the screenshots and formatting intact.",
		body: "A Python converter and PowerShell vault bootstrapper turn exported .mht notebooks into clean Obsidian markdown with preserved images and searchable OCR text. Tested in production on 5 real notebooks: 560+ pages and 585+ images at 99.7 to 100% word fidelity.",
		stack: ["Python", "PowerShell", "OCR", "Obsidian"],
		url: "https://github.com/Exploitacious/OneNote-to-Obsidian",
		linkLabel: "Exploitacious/OneNote-to-Obsidian",
	},
	{
		name: "agentfarm",
		tag: "Agent provisioning, Proxmox",
		hook: "A self-hosted AI agent from one command instead of an afternoon of boilerplate.",
		body: "The deployment scripts and container templates I use to stand up autonomous agents on Proxmox LXC or any Debian or Ubuntu host: tiered model routing, messaging bridges, Tailscale connectivity, persistent memory plugins, and initial hatching setup.",
		stack: ["Shell", "Proxmox LXC", "Tailscale", "Docker"],
		url: "https://github.com/Exploitacious/agentfarm",
		linkLabel: "Exploitacious/agentfarm",
	},
];

// The flagship leads the private list.
const productionBuilds: ProjectItem[] = [
	{
		name: "Enterprise MCP Platform & Cross-Vendor Entity Graph",
		tag: "Production AI infrastructure, data engineering",
		hook: "30+ MCP servers, and one PostgreSQL graph that unifies 8+ vendor platforms.",
		body: "A monorepo of isolated FastMCP servers covering PSA, RMM, documentation, M365, security, billing, networking, and voice, behind a self-hosted MCP gateway. Underneath runs a PostgreSQL entity graph with 130+ schema migrations and scheduled sync workers that unify people, devices, cameras, network gear, and inventory across platforms through MAC address and identity resolution.",
		stack: ["Python 3.12", "FastMCP", "PostgreSQL 16", "Alembic", "Terraform", "Docker"],
	},
	{
		name: "Financial Signals & Market Intelligence Platform",
		tag: "Full-stack, signals intelligence",
		hook: "2,500+ commits of market analytics, with 13 MCP tools for AI trading agents.",
		body: "A FastAPI backend pulls live brokerage options chains (GEX, ZGL, PCR), macro liquidity feeds, dark pool positioning, price technicals, and AI-scored news sentiment on 5-minute, 15-minute, and overnight schedules. It classifies market regimes, computes composite health scores, fires threshold alerts, serves an Astro SSR dashboard, and watches itself with an isolated crash-loop watchdog sidecar.",
		stack: ["Python", "FastAPI", "Astro SSR", "MCP", "Options Analytics", "Macro Data"],
	},
	{
		name: "Client-Facing AI Discovery Platform",
		tag: "Cloudflare Workers, full-stack",
		hook: "Hatchling's conversation engine, rebuilt at the edge to run client discovery interviews.",
		body: "Built on Cloudflare Workers, Hono, D1, and Durable Objects. Staff send a client a unique link or a short entry code; the client works through a guided Theory-of-Constraints interview while the model writes structured discovery notes through tool calls. Each session runs in its own Durable Object, which keeps turns in order and enforces a budget.",
		stack: ["TypeScript", "Hono", "Cloudflare Workers", "D1", "Durable Objects", "React"],
	},
	{
		name: "Nonprofit OAuth 2.1 MCP Connector Suite",
		tag: "Pro-bono, Cloudflare Workers",
		hook: "AI connectors a local nonprofit's volunteer platform never had, signed in with Microsoft.",
		body: "Built for a local nonprofit's AI rollout. A shared OAuth 2.1 authorization service fronts per-platform connectors, and staff sign in with the Microsoft identity they already have. Every write is previewed, confirmed, read back, and recorded in an audit ledger, and one switch can shut the whole suite off.",
		stack: ["TypeScript", "Cloudflare Workers", "OAuth 2.1", "Microsoft Entra ID", "MCP", "D1"],
	},
	{
		name: "The Homelab & AI Fleet",
		tag: "Infrastructure, AI fleet",
		// No external link: the status page is private now.
		hook: "18+ self-hosted services and a small fleet of AI agents with actual day jobs.",
		body: "A Proxmox estate, and the reason I stay sharp on infrastructure nobody pays me to touch. A personal MCP gateway gives my agents governed access to the whole thing, and they work it: watching infrastructure and handling the household logistics nobody enjoys. The household-facing pieces have their own uptime monitoring, kept private.",
		stack: ["Proxmox", "Docker", "MCP", "Self-hosted"],
	},
];

const totalProjects = openSourceProjects.length + productionBuilds.length;

const sections = [
	{
		id: "open-source",
		heading: "Open source",
		sub: "Public repos, upstream fixes, and a maintained fork.",
		items: openSourceProjects,
	},
	{
		id: "production-builds",
		heading: "Private production builds",
		sub: "Production platforms and private builds with no public repo.",
		items: productionBuilds,
	},
];
---

<Layout
	title="Projects | Alex Ivantsov"
	description="What I build outside the day job: MSP tooling, AI agent software, an operator's harness for Claude Code, and the homelab that runs the rest of it."
>
	<Nav currentPath="/projects" />

	<main id="main">
		<!-- Hero -->
		<section class="mx-auto max-w-6xl px-5 md:px-8 pt-12 md:pt-20 pb-12">
			<p class="text-sm text-muted mb-5">Projects</p>
			<h1 class="display text-[clamp(2.4rem,5.2vw,4.25rem)] font-semibold leading-[1.02] max-w-[18ch]">
				Things I built because I needed them.
			</h1>
			<p class="mt-6 text-lg md:text-xl text-muted prose-measure">
				{totalProjects} systems: {openSourceProjects.length} public repos,
				upstream contributions, and forks, and {productionBuilds.length} production
				platforms and private builds running across cloud, edge, and homelab
				infrastructure.
			</p>
			<nav aria-label="On this page" class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
				{sections.map((s) => (
					<a href={`#${s.id}`} class="link">{s.heading} ({s.items.length})</a>
				))}
			</nav>
		</section>

		{
			sections.map((section) => (
				<section id={section.id} class="border-t border-rule scroll-mt-20">
					<div class="mx-auto max-w-6xl px-5 md:px-8 pt-14 md:pt-16">
						<div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2 md:gap-8 mb-6">
							<h2 class="display text-3xl md:text-4xl font-semibold">{section.heading}</h2>
							<p class="text-muted md:text-right">{section.sub}</p>
						</div>
						<ul>
							{section.items.map((p) => (
								<li class="grid md:grid-cols-12 gap-3 md:gap-12 py-9 border-t border-rule">
									<div class="md:col-span-4">
										<h3 class="display text-2xl font-semibold leading-tight">
											{p.url ? (
												<a href={p.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{p.name}</a>
											) : (
												p.name
											)}
										</h3>
										<p class="mt-2 text-sm text-muted">{p.tag}</p>
									</div>
									<div class="md:col-span-8">
										<p class="text-lg md:text-xl font-medium leading-snug text-ink prose-measure">{p.hook}</p>
										<p class="mt-3 text-muted leading-relaxed prose-measure">{p.body}</p>
										<p class="mt-4 font-mono text-xs text-muted">{p.stack.join("  /  ")}</p>
										{p.url ? (
											<a href={p.url} target="_blank" rel="noopener noreferrer" class="link mt-3 inline-block text-sm font-medium break-all">
												{p.linkLabel}
											</a>
										) : section.id === "production-builds" ? (
											<p class="mt-3 text-sm text-muted">Private, no public repo</p>
										) : null}
									</div>
								</li>
							))}
						</ul>
					</div>
				</section>
			))
		}

		<!-- CTA -->
		<section class="mx-auto max-w-6xl px-5 md:px-8 mt-10">
			<div class="border-t border-ink pt-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
				<p class="display text-2xl md:text-3xl font-semibold">Want to talk about any of these builds?</p>
				<div class="flex flex-wrap gap-3">
					<a href="mailto:alex@ivantsov.tech" class="btn btn-solid">Email me</a>
					<a href="/about" class="btn btn-quiet">Read my background</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
